# 매장 PC에 설치된 에이전트 1대당 토큰 1개. cctv-agent-electron 앱의 서버 설정 화면에
# 붙여넣는 deviceToken과 같은 값이어야 한다. userId 는 이제 Supabase Auth 유저의 uuid다
# (schema.sql 에서 videos/anomaly_events.user_id 가 auth.users(id) FK) — 매장 운영자가
# Supabase Auth 로 회원가입한 계정의 uuid를 여기 넣어야 하고, "owner-1" 같은 임의
# 문자열을 넣으면 영상 업로드 시 FK 위반으로 insert 가 실패한다.
# uuid 확인: Supabase 대시보드 > Authentication > Users 에서 해당 계정 클릭 > User UID.
# docker stack deploy 는 .env 를 자동으로 안 읽어서 deploy.sh 가 이 파일을 직접
# `source` 한다 — 그래서 JSON 값은 반드시 작은따옴표로 감싸야 큰따옴표가 살아남는다.
DEVICE_TOKENS='[{"token":"replace-with-a-random-secret","storeId":"store-gangnam-01","userId":"00000000-0000-0000-0000-000000000000","label":"강남점 PC"}]'

# 메인스트림 5분 조각(약 150MB)이 통과하도록 여유를 둔 기본값.
# nginx/nginx.conf 의 client_max_body_size 와 같이 맞춰서 바꿀 것.
MAX_SEGMENT_BYTES=262144000

# Supabase 프로젝트 설정 > API 에서 확인. 비워두면 ingest-worker는 로컬 저장까지만
# 하고 ai-worker 핸드오프를 건너뛰며, backend 조회 API는 503을 반환한다 — 둘 다 죽지는
# 않는다. supabase/schema.sql 을 먼저 이 프로젝트의 SQL Editor에서 실행해둘 것.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# backend 가 클립/썸네일에 발급하는 signed URL 유효시간(초).
SIGNED_URL_TTL_SEC=3600

# 프론트가 Supabase Auth 로 로그인해서 받은 access token(JWT)을 backend가 검증하는 데
# 쓰는 비밀값. Supabase 대시보드 > Project Settings > API > JWT Settings > JWT Secret.
# 비워두면 로그인 필요한 조회 라우트(/videos, /videos/:id, /clips)가 전부 503을 반환한다.
SUPABASE_JWT_SECRET=

# ai-worker 튜닝값. 5분 정도 배회하는 느린 이상행동엔 window/stride를 키우고,
# 30초 내로 끝나는 절도처럼 빠른 행동엔 줄이는 식으로 조정한다.
# AI_WORKER_POLL_INTERVAL_SEC=5
# AI_WORKER_POSE_MODEL=yolo11n-pose.pt
# AI_WORKER_ANOMALY_WINDOW_FRAMES=32
# AI_WORKER_ANOMALY_STRIDE_FRAMES=8
# AI_WORKER_ANOMALY_THRESHOLD_STD=2.5
# AI_WORKER_ANOMALY_MIN_SEGMENT_FRAMES=16

# 이미지 태그. 여러 노드로 구성된 스웜이라 레지스트리 푸시가 필요해지면 여기를
# registry.example.com/scene-stealer-back-ingest-worker:latest 같은 값으로 바꾼다.
# INGEST_WORKER_IMAGE=scene-stealer-back-ingest-worker:latest
# AI_WORKER_IMAGE=scene-stealer-back-ai-worker:latest
# BACKEND_IMAGE=scene-stealer-back-backend:latest
# NGINX_IMAGE=scene-stealer-back-nginx:latest

# ── 도메인 API 추가 설정 (docs/api-contract.md) ──────────────────────────────

# ingest-worker 가 backend 의 /internal/* 를 부를 때 쓰는 공유 비밀값.
# nginx 는 /internal/ 을 404 로 막지만 네트워크 격리 하나에만 기대지 않는다.
# 아무 랜덤 문자열이면 된다: openssl rand -hex 32
INTERNAL_API_TOKEN=

# 푸시(FCM). 비워두면 푸시를 보내지 않고 로그만 남긴다 — 조용히 성공한 척하지
# 않으려는 것이다 (backend/app/push.py).
FCM_SERVER_KEY=

# 영업시간·수면시간 판정 기준 시간대. 매장이 전부 한국이라 전역 설정이다.
STORE_TIMEZONE=Asia/Seoul

# ai-worker 가 남긴 anomaly_events 를 backend 가 위험 이벤트로 옮기는 주기(초).
# ai-worker 는 backend 를 모른다 — 이벤트 생성·알림은 전부 backend 몫이다.
ANOMALY_POLL_SEC=5
