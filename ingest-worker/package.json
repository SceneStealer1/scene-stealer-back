{
  "name": "scene-stealer-ingest-worker",
  "version": "1.0.0",
  "private": true,
  "description": "cctv-agent-electron 이 POST /v1/segments 로 올리는 영상 조각을 받아 로컬 디스크에 적재하고, Supabase 를 통해 ai-worker 로 핸드오프하는 인제스트 워커",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "multer": "^2.0.0",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2"
  }
}
